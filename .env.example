# Google Web OAuth client (never use the localhost-only gws Desktop client here)
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Notion personal access token used by scheduled syncs for title search
NOTION_API_TOKEN=ntn_replace-me

# ID of the active Postbox root folder in Google Drive
POSTBOX_FOLDER_ID=replace-me

# Optional tuning
POSTBOX_SUBFOLDERS=A,B,C
SYNC_BATCH_SIZE=10
DELTA_BUFFER_MS=60000
MAX_CONTENT_BYTES=460800
